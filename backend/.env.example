# Sugandhika backend environment
NODE_ENV=development
PORT=5000

# PostgreSQL (Neon or any PostgreSQL provider)
# Replace with your real connection string; do not commit backend/.env
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# JWT authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary image storage (create a free account at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud_name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Local Vite origins; add your deployed frontend URL in production
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_FILE_SIZE_MB=10
