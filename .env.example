# ─── Database (Prisma / Next.js) ─────────────────────────────────────────────
# For Supabase: use the pooling URL for DATABASE_URL and direct URL for DIRECT_URL.
# Generate at: https://supabase.com/dashboard/project/<project>/settings/database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET"

# ─── Public / App URLs ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Django API base URL (client-side) ───────────────────────────────────────
# Set to the Render backend URL in production.
# The Django backend must be running and its CORS_ALLOWED_ORIGINS must include
# the Next.js origin.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# ─── Cloudinary (product images) ─────────────────────────────────────────────
# Create an account at https://cloudinary.com and use the provided credentials.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

# ─── Resend (email) ───────────────────────────────────────────────────────────
# Create an account at https://resend.com and verify your sending domain.
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXX"
EMAIL_FROM="noreply@sugandhika.com"
