# Prisma PostgreSQL connection strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth: generate a unique secret for each environment (for example: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET"

# Optional staged handoff for /admin to Django's owner-only dashboard.
# Keep server-side only (do not use NEXT_PUBLIC_); leave unset until Django is deployed and tested.
DJANGO_OWNER_DASHBOARD_URL=""

# Public Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloudinary configuration: replace placeholders with real values in deployment secrets.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"
